# Quarto / R working files – safe to ignore, they regenerate.
/.quarto/
/_site/
.Rproj.user
*_cache/
.DS_Store

# Working notes for the facilitator and the assistant, never published. This
# repository is public, so the file is ignored here as a mechanical backstop; if
# one is ever needed in this workspace, it stays untracked.
CLAUDE.md

# Respondent-level files built from the GESIS Eurobarometer downloads by
# prep/01_build_respondents.R. They are derived microdata under the GESIS
# terms of use and must never be committed, pushed or shared. The folder is
# ignored as a backstop; the raw .dta files should live outside the workspace.
/data_private/

# A second backstop, for files saved anywhere in the folder: the formats in
# which GESIS distributes the waves, their archives, and R data files, the
# format in which the build script saves the file of respondents.
*.dta
*.sav
*.por
*.zip
*.rds

# Deliberately NOT ignored:
#   /_freeze/  – committed so GitHub Actions can publish without re-running R.
#   /data/     – the CSVs are committed so the report renders offline.

**/*.quarto_ipynb

# The class-chart tag of this copy of the workspace (written by R/spec_tools.R)
.class-tag
